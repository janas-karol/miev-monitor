<?xml version="1.0" encoding="utf-8"?>
<!--
  Ekran glowny z czterema zakladkami:
    Start    - tarcza mocy, kafle, napiecia i temperatury,
    Ogniwa   - wszystkie 88 ogniw (siatka, wygodna w poziomie),
    Odcinek  - biezacy odcinek + historia jazd,
    Inne     - pozostale parametry, eksport, ustawienia ekranu.
  Naglowek (adapter + status) jest wspolny dla wszystkich zakladek.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- naglowek: adapter + polaczenie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/deviceSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/muted" />

            <Button
                android:id="@+id/connectButton"
                style="@style/AppButtonPrimary"
                android:text="Połącz" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Nie połączono z adapterem"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- tresc zakladek -->
    <FrameLayout
        android:id="@+id/panelHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- zakladka: START -->
        <ScrollView
            android:id="@+id/panelStart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp">

                    <io.github.janaskarol.miev.PowerGaugeView
                        android:id="@+id/powerGauge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/peakText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="rekuperacja −25 kW · pobór 50 kW"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:paddingLeft="6dp"
                        android:text="OSTATNIE 2 MIN"
                        android:textColor="@color/dim"
                        android:textSize="10sp" />

                    <io.github.janaskarol.miev.SparklineView
                        android:id="@+id/powerSpark"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- napiecia -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/CardTitle" android:text="NAPIĘCIA OGNIW" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="MIN" />
                            <TextView android:id="@+id/cellMinValue" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="MAX" />
                            <TextView android:id="@+id/cellMaxValue" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="ROZRZUT" />
                            <TextView android:id="@+id/cellDeltaValue" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/packText"
                        style="@style/Foot"
                        android:text="Pakiet –" />
                </LinearLayout>

                <!-- temperatury -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/CardTitle" android:text="TEMPERATURY BATERII" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="MIN" />
                            <TextView android:id="@+id/tempMinValue" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="MAX" />
                            <TextView android:id="@+id/tempMaxValue" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="RÓŻNICA" />
                            <TextView android:id="@+id/tempDeltaValue" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tempsText"
                        style="@style/Foot"
                        android:text="Czujniki –" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- zakladka: OGNIWA -->
        <ScrollView
            android:id="@+id/panelCells"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/CardTitle" android:text="WSZYSTKIE OGNIWA" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="MIN" />
                            <TextView android:id="@+id/cellTabMin" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="MAX" />
                            <TextView android:id="@+id/cellTabMax" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="ROZRZUT" />
                            <TextView android:id="@+id/cellTabDelta" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cellSummary"
                        style="@style/Foot"
                        android:text="Czekam na ramkę 2102 — 88 ogniw" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cellGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="10dp" />
            </LinearLayout>
        </ScrollView>

        <!-- zakladka: ODCINEK i HISTORIA -->
        <ScrollView
            android:id="@+id/panelTrip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/CardTitle" android:text="TEN ODCINEK" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="DYSTANS" />
                            <TextView android:id="@+id/tripDistance" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="ENERGIA" />
                            <TextView android:id="@+id/tripEnergy" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="NA 100 KM" />
                            <TextView android:id="@+id/tripPer100" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="CZAS" />
                            <TextView android:id="@+id/tripTime" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="ŚREDNIA" />
                            <TextView android:id="@+id/tripAvg" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Label" android:text="REKUP." />
                            <TextView android:id="@+id/tripRegen" style="@style/MetricSmall" android:text="–" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tripFoot"
                        style="@style/Foot"
                        android:text="Odcinek startuje automatycznie, gdy auto ruszy" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/CardTitle" android:text="HISTORIA JAZD" />

                    <LinearLayout
                        android:id="@+id/historyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/historyEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:text="Brak zapisanych jazd — pierwszy odcinek pojawi się po 120 s postoju"
                        android:textColor="@color/dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- zakladka: INNE -->
        <ScrollView
            android:id="@+id/panelOther"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="16dp">

                <!-- kafle: SoC / predkosc / grzanie -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView style="@style/Label" android:text="SOC" />
                        <TextView android:id="@+id/socValue" style="@style/Metric" android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView style="@style/Label" android:text="PRĘDKOŚĆ" />
                        <TextView android:id="@+id/speedValue" style="@style/Metric" android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView style="@style/Label" android:text="GRZANIE PTC" />
                        <TextView android:id="@+id/heaterValue" style="@style/Metric" android:text="–" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/CardTitle" android:text="POZOSTAŁE" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">
                        <TextView style="@style/RowKey" android:text="Zasięg" />
                        <TextView android:id="@+id/rangeValue" style="@style/RowValue" android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">
                        <TextView style="@style/RowKey" android:text="Licznik" />
                        <TextView android:id="@+id/odoValue" style="@style/RowValue" android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">
                        <TextView style="@style/RowKey" android:text="Płyn grzewczy" />
                        <TextView android:id="@+id/coolantValue" style="@style/RowValue" android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">
                        <TextView style="@style/RowKey" android:text="Klima" />
                        <TextView android:id="@+id/acValue" style="@style/RowValue" android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">
                        <TextView style="@style/RowKey" android:text="Bufor próbek" />
                        <TextView android:id="@+id/logValue" style="@style/RowValue" android:text="0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">
                        <TextView style="@style/RowKey" android:text="Ogniwa" />
                        <TextView android:id="@+id/cellsText" style="@style/RowValue" android:text="–" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/exportButton"
                        style="@style/AppButton"
                        android:text="Eksport CSV" />

                    <Button
                        android:id="@+id/clearButton"
                        style="@style/AppButton"
                        android:layout_marginLeft="8dp"
                        android:text="Wyczyść bufor" />
                </LinearLayout>

                <ToggleButton
                    android:id="@+id/screenToggle"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button"
                    android:textAllCaps="false"
                    android:textColor="@color/muted"
                    android:textOff="Ekran może gasnąć"
                    android:textOn="Ekran zawsze włączony"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/csvPathText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:textColor="@color/dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/aboutText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:textColor="@color/dim"
                    android:textSize="10sp"
                    android:text="i-MiEV Monitor — nieoficjalna aplikacja, niepowiązana z Mitsubishi Motors.\nBrak dostępu do internetu — dane nie opuszczają telefonu." />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- pasek zakladek -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cardStroke" />

    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0E1218"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabStart"
            style="@style/TabItem"
            android:text="START" />

        <TextView
            android:id="@+id/tabCells"
            style="@style/TabItem"
            android:text="OGNIWA" />

        <TextView
            android:id="@+id/tabTrip"
            style="@style/TabItem"
            android:text="ODCINEK" />

        <TextView
            android:id="@+id/tabOther"
            style="@style/TabItem"
            android:text="INNE" />
    </LinearLayout>
</LinearLayout>
